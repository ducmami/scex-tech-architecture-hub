        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  layout: dagre\n  look: handDrawn\n  flowchart:\n    curve: step\n---\nflowchart LR\n subgraph CLIENT[\&quot;👤 Client Layer\&quot;]\n    direction LR\n        APP[\&quot;📱 Mobile App\\n(Android / iOS)\&quot;]\n        WEB[\&quot;🌐 dp-scex-website\\n(React / Next.js)\&quot;]\n        PARTNER_CLIENT[\&quot;🤝 Partner Apps\\n(External)\&quot;]\n        SDK_CLIENT[\&quot;📱 scex-crypto-sdk\\n(Mobile SDK Client)\&quot;]\n  end\n subgraph LPEX_LAYER[\&quot;🔀 LPEX Gateway Layer\&quot;]\n    direction LR\n        LPEX_GW[\&quot;lpex.scex.com.vn\&quot;]\n        KYC_API[\&quot;kyc-api.scex.com.vn\&quot;]\n        TRADING_API[\&quot;trading-uat.scex.com.vn\&quot;]\n  end\n subgraph GATEWAY_LAYER[\&quot;🔀 Gateway Layer\&quot;]\n    direction LR\n        GW[\&quot;🚪 dp-scex-gateway-service\\n(API Gateway)\&quot;]\n        PGW[\&quot;🔗 dp-scex-partner-gateway-service\\n(Partner Gateway)\&quot;]\n        IGW[\&quot;🏛️ dp-internal-gateway-service\\n(VNeID / Internal Partner BFF)\&quot;]\n        SDKGW[\&quot;📱 dp-scex-sdk-gateway-service\\n(Mobile SDK BFF)\&quot;]\n  end\n subgraph SERVICE_LAYER[\&quot;⚙️ Service Layer (Spring Boot — Clean Architecture)\&quot;]\n    direction LR\n        AUTH[\&quot;🔐 dp-auth-service\\n(Authentication &amp;\\nAuthorization)\&quot;]\n        GAMIFICATION[\&quot;🎰 dp-scex-gamification-service\\n(Case Spinning /\\nPromotion)\&quot;]\n        FEATURE[\&quot;🚩 dp-feature-flag-service\\n(Feature Toggle)\&quot;]\n        TRACKING[\&quot;📊 dp-scex-tracking-service\\n(Behavior Tracking)\&quot;]\n        AFFILIATE[\&quot;🤝 dp-scex-affiliate-service\\n(Affiliate / IB Onboarding\\n&amp; Dashboard)\&quot;]\n        CORE_SVC[\&quot;🪪 dp-scex-core-service\\n(VNeID SSO / Share-Info /\\nLiveness / Withdraw-Consent)\&quot;]\n        SDK_SVC[\&quot;⚙️ dp-scex-sdk-service\\n(Auth/Session, eKYC, Trading,\\nWallet, Deposit, Notification)\&quot;]\n  end\n subgraph EXTERNAL[\&quot;🏛️ External Government / IT\&quot;]\n    direction LR\n        IT_PROXY[\&quot;IT Agent Gateway/Proxy\&quot;]\n        VNEID[\&quot;VNeID\\n(National e-ID Platform)\&quot;]\n        CORE_REMI[\&quot;Core Remi\\n(MTK account-activation /\\nconsent-lifecycle owner —\\nTBD which service)\&quot;]\n  end\n subgraph INFRA[\&quot;🏗️ Infrastructure Layer\&quot;]\n    direction LR\n        PG[(\&quot;🗄️ PostgreSQL\\n(Primary DB)\&quot;)]\n        REDIS[(\&quot;⚡ Redis\\n(Cache / Session)\&quot;)]\n        CLICKHOUSE[(\&quot;🗄️ ClickHouse\\n(Tracking DB)\&quot;)]\n        KAFKA[\&quot;📨 Kafka\\n(Message Queue)\&quot;]\n        EMQX[\&quot;EMQX (Websocket System)\&quot;]\n  end\n subgraph SECURITY[\&quot;🛡️ Security &amp; Observability\&quot;]\n    direction LR\n        ELK[\&quot;📋 ELK Stack\\n(Logging)\&quot;]\n        PROM[\&quot;📈 Prometheus\\n+ Grafana\&quot;]\n  end\n    APP -- JWT Bearer --&gt; LPEX_LAYER\n    WEB -- HTTPS + JWT Bearer --&gt; GW\n    PARTNER_CLIENT -- HTTPS + API Key --&gt; PGW\n    SDK_CLIENT -- HTTPS + Bearer RS256 --&gt; SDKGW\n    GATEWAY_LAYER -- HTTP Basic Auth --&gt; SERVICE_LAYER\n    SERVICE_LAYER -- \&quot;Rest API/Events/...\&quot; --&gt; EXTERNAL\n    SERVICE_LAYER -. Logs .-&gt; ELK\n    SERVICE_LAYER -. Metrics .-&gt; PROM\n    SERVICE_LAYER -- Read/Write/Cache/Pub/Sub --&gt; INFRA\n    IT_PROXY -- API Key --&gt; IGW\n\n    style GATEWAY_LAYER fill:#fff3e0,stroke:#FF9800,color:#000\n    style SERVICE_LAYER fill:#e8f5e9,stroke:#4CAF50,color:#000\n    style EXTERNAL fill:#ede7f6,stroke:#5E35B1,color:#000\n    style INFRA fill:#fce4ec,stroke:#E91E63,color:#000\n    style CLIENT fill:#e8f4fd,stroke:#2196F3,color:#000\n    style SECURITY fill:#f3e5f5,stroke:#9C27B0,color:#000&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HvqRdZM5yzj6aR1HOAif-1">
