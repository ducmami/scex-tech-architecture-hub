        <mxCell id="ov-svc-body" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=2;spacingTop=2;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width: 100%; border-collapse: collapse; font-family: Helvetica;&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background-color: rgb(227, 242, 253); font-weight: bold;&quot;&gt;&lt;th style=&quot;width:22%&quot;&gt;Service&lt;/th&gt;&lt;th style=&quot;width:16%&quot;&gt;Zone&lt;/th&gt;&lt;th style=&quot;width:62%&quot;&gt;Chức năng chính&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Client&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Frontend App/Web&lt;/td&gt;&lt;td&gt;Client&lt;/td&gt;&lt;td&gt;Đặt 4 loại lệnh (Limit/Market/Stop Limit/Stop Market); orderbook realtime; lệnh mở &amp;amp; lịch sử; WS cập nhật status + số dư&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Admin Portal&lt;/td&gt;&lt;td&gt;Client&lt;/td&gt;&lt;td&gt;Tra cứu/huỷ lệnh; cấu hình ngưỡng Deviation Guard &amp;amp; Circuit Breaker; resume cặp; audit log&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Core (Backend)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;API Layer + Throttler&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;API trung tâm; validate &amp;amp; vòng đời lệnh; rate limit 5/s; điều phối Trading / Balance / Notify&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Deviation Guard &amp;amp; Circuit Breaker&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Tính |Last−Index|/Index; chuyển TRADING/RESTRICTED/SUSPENDED/COOL_DOWN theo circuit_breaker_configs&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Trading System&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Matching Engine&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Khớp lệnh Price-Time Priority (FIFO); tính fee/tax amount tại thời điểm khớp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Conditional Order Manager&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Giám sát last price; trigger Stop Limit/Stop Market thành Limit/Market vào ME&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Order Matching Result Verification&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Xác minh kết quả khớp tuân thủ Price-Time Priority và ràng buộc nghiệp vụ&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;br&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Market Data Service&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Orderbook, last price, recent trades, index; WS cho FE; last+index cho COM và Deviation Guard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fund Flow Orchestrator&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Nhận lock/unlock/debit/credit từ Kafka; điều phối luồng số dư&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ledger Entry Coordinator&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Điều phối bút toán kế toán; đảm bảo idempotency&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Ledger Posting Engine&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Ghi sổ và cập nhật số dư thực tế (source of truth)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fee Service&lt;/td&gt;&lt;td&gt;SCEX Core&lt;/td&gt;&lt;td&gt;Phí/thuế (US.04 ngoài phạm vi tài liệu Trading)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Data &amp;amp; Messaging&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Postgres&lt;/td&gt;&lt;td&gt;Data&lt;/td&gt;&lt;td&gt;Persist orders, trades, symbol_infos, circuit_breaker_events&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Redis&lt;/td&gt;&lt;td&gt;Data&lt;/td&gt;&lt;td&gt;Rate limiting (ThrottlerMiddleware) và cache tiền kiểm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Kafka&lt;/td&gt;&lt;td&gt;Messaging&lt;/td&gt;&lt;td&gt;Event bus lock/unlock/settle, TradeEvent, child Stop order&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;External&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Email SMTP / Firebase FCM&lt;/td&gt;&lt;td&gt;External&lt;/td&gt;&lt;td&gt;Push/email khi lệnh FILLED hoặc CANCELLED&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
