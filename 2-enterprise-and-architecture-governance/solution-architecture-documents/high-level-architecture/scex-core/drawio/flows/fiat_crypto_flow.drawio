        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant Backend\n    participant FiatService\n    participant LPBank\n\n    User-&gt;&gt;Backend: Thêm tài khoản thụ hưởng\n    Backend-&gt;&gt;FiatService: Check Tài khoản\n    FiatService-&gt;&gt;LPBank: Truy vấn tài khoản thụ hưởng\n\n    alt ok\n        LPBank--&gt;&gt;FiatService: Tài khoản thụ hưởng\n        FiatService--&gt;&gt;Backend: return OK\n        Backend-&gt;&gt;Backend: Save tài khoản thụ hưởng\n    else not ok\n        LPBank--&gt;&gt;FiatService: Lỗi truy vấn\n        FiatService--&gt;&gt;Backend: return NotValid\n    end\n\n    Backend--&gt;&gt;User: Show kết quả\n    User-&gt;&gt;Backend: Yêu cầu rút tiền\n    Backend-&gt;&gt;Backend: Lock tiền trong BalanceEngine\n    Backend-&gt;&gt;Backend: Tạo FiatWithdrawal\n    Backend-&gt;&gt;FiatService: Post FiatWithdrawal\n    FiatService-&gt;&gt;FiatService: Create User Fiat Withdrawal\n    FiatService-&gt;&gt;LPBank: Yêu cầu Chi Hộ\n    LPBank--&gt;&gt;FiatService: Return Transaction\n    FiatService-&gt;&gt;FiatService: Lưu transId lại\n\n    loop Fetch Transaction Status\n        FiatService-&gt;&gt;LPBank: Kiểm tra transaction theo transId\n    end\n\n    FiatService--&gt;&gt;Backend: Sync FiatWithdrawal\n    Backend-&gt;&gt;Backend: Update FiatWithdrawal Status\n    Backend-&gt;&gt;Backend: Burn số dư đã lock\n    Backend--&gt;&gt;User: Hiển thị kết quả rút tiền.&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8x6ZOKiIoBxTGwTs5f-3-32">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
