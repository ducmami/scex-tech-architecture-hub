        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant User\n    participant FE as Frontend App\n    participant Core as Core (Backend)\n    participant DB as Database\n    participant Crypto as Crypto Service\n\n    User-&gt;&gt;FE: Chọn token + chain để nạp\n    FE-&gt;&gt;Core: GET /coin_accounts?network=xxx\n    Core-&gt;&gt;DB: CoinAccountRepository.GetByUserAndChain(user_id, chain)\n\n    alt Đã có địa chỉ nạp\n        DB--&gt;&gt;Core: Trả về địa chỉ hiện có\n        Core--&gt;&gt;FE: 200 + deposit_address\n    else Chưa có địa chỉ nạp\n        DB--&gt;&gt;Core: nil\n        Core-&gt;&gt;Crypto: POST /deposit_addresses (user_id, chain)\n\n        alt Tạo địa chỉ thành công\n            Crypto--&gt;&gt;Core: deposit_address mới\n            Core-&gt;&gt;DB: Lưu coin_accounts (user_id, chain, address)\n            Core--&gt;&gt;FE: 200 + deposit_address\n        else Tạo địa chỉ thất bại\n            Crypto--&gt;&gt;Core: Error\n            Core--&gt;&gt;FE: 500 Error\n            FE--&gt;&gt;User: Hiển thị thông báo lỗi, cho phép thử lại\n        end\n    end\n\n    FE--&gt;&gt;User: Hiển thị QR code + địa chỉ nạp + thông tin cấu hình&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aB8aDLMw8Eljix8oJV8i-5">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
