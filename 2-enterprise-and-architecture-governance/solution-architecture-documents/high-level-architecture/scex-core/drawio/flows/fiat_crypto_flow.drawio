        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant Crypto as Crypto Service\n    participant Core as Core (Backend)\n    participant DB as Database\n    participant AML as AML Service\n    participant Kafka as Kafka\n    participant Balance as Balance System\n    participant Notify as Notification Service\n    participant FE as Frontend App\n\n    Note over Crypto: Quét block mới từ chain\n    Crypto-&gt;&gt;Core: Postback pending (tx_hash, ...)\n    Core-&gt;&gt;DB: Ghi nhận giao dịch (raw_status = pending)\n    Core--&gt;&gt;Crypto: ACK\n\n    Note over Crypto: Đủ block confirmations\n    Crypto-&gt;&gt;Core: Postback network_confirmed\n    Core-&gt;&gt;DB: Validate giao dịch (token, amount &gt;= deposit_min)\n\n    alt Không đạt min\n        Core-&gt;&gt;DB: Ghi nhận vào danh sách dưới mức (admin xem xét)\n    else Đạt min\n        Core-&gt;&gt;DB: Update raw_status = network_confirmed\n        Core-&gt;&gt;Notify: Thông báo \&quot;Đang xử lý\&quot;\n        Core-&gt;&gt;FE: WebSocket cập nhật\n        Core-&gt;&gt;DB: Kiểm tra deposit_enable\n\n        alt deposit_enable = false\n            Core-&gt;&gt;DB: Update raw_status = blocked\n        else deposit_enable = true\n            Core-&gt;&gt;AML: Quét AML\n\n            alt AML flag/manual review\n                Core-&gt;&gt;DB: Update raw_status = manual_review_required\n                alt Admin approve\n                    Core-&gt;&gt;DB: Update raw_status = approved\n                else Admin reject\n                    Core-&gt;&gt;DB: Update raw_status = rejected\n                end\n            else AML pass\n                Core-&gt;&gt;DB: Update raw_status = approved\n            end\n\n            alt raw_status = approved\n                Core-&gt;&gt;Kafka: CoinDepositApprovedEvent\n                Kafka-&gt;&gt;Balance: Consume event, cộng số dư\n                Core-&gt;&gt;DB: Update raw_status = approved_fund_settled\n                Core-&gt;&gt;Notify: Thông báo \&quot;Thành công\&quot;\n                Core-&gt;&gt;FE: WebSocket cập nhật số dư + trạng thái\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7B_Wn63NEHVE41KscFrt-168">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
