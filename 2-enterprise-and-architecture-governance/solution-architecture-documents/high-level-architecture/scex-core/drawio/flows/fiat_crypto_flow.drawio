        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant FE as Frontend App\n    participant Core as Core (Backend)\n    participant DB as Database\n    participant AML as AML Service\n    participant Balance as Balance System\n    participant Crypto as Crypto Service\n\n    User-&gt;&gt;FE: Nhập thông tin rút, xác nhận\n    FE-&gt;&gt;Core: Tạo yêu cầu rút\n    Core-&gt;&gt;DB: Kiểm tra điều kiện (KYC, balance, hạn mức, v.v)\n\n    alt Không hợp lệ\n        Core--&gt;&gt;FE: Báo lỗi\n    else Hợp lệ\n        Core-&gt;&gt;DB: Tạo yêu cầu rút\n        Core--&gt;&gt;FE: Yêu cầu xác nhận 2FA\n        FE--&gt;&gt;User: Yêu cầu xác nhận 2FA\n        User-&gt;&gt;FE: Xác nhận 2FA\n        FE-&gt;&gt;Core: Xác nhận 2FA\n        Core-&gt;&gt;DB: Cập nhật lệnh rút là đã xác minh\n        Core-&gt;&gt;AML: Kiểm tra AML\n\n        alt Dính AML/manual review\n            Core-&gt;&gt;DB: Chờ phê duyệt admin\n        else Đạt AML\n            Core-&gt;&gt;Balance: Khoá số dư\n\n            alt Lock thất bại\n                Core--&gt;&gt;FE: Báo lỗi số dư\n            else Lock thành công\n                Core-&gt;&gt;Crypto: Thực hiện rút on-chain\n\n                alt Rút thành công (nhận tx_hash)\n                    Core-&gt;&gt;DB: Cập nhật giao dịch, chờ xác nhận mạng\n                    Crypto-&gt;&gt;Core: Đã xác nhận đủ block\n                    Core-&gt;&gt;DB: Trừ số dư, hoàn tất giao dịch\n                    Core--&gt;&gt;FE: Báo rút thành công\n                else Rút lỗi\n                    Core--&gt;&gt;FE: Báo lỗi, admin xử lý thủ công\n                end\n            end\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7B_Wn63NEHVE41KscFrt-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=1;groupPadding=20;" vertex="1">
