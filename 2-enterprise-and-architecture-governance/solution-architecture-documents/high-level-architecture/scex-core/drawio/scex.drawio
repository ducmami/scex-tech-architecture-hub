        <mxCell id="svcFnTbl-body" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacingLeft=2;spacingTop=2;overflow=fill;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;width: 100%; border-collapse: collapse; font-family: Helvetica;&quot;&gt;&lt;thead&gt;&lt;tr style=&quot;background-color: rgb(227, 242, 253); font-weight: bold;&quot;&gt;&lt;th style=&quot;width:24%&quot;&gt;Service&lt;/th&gt;&lt;th style=&quot;width:20%&quot;&gt;Zone&lt;/th&gt;&lt;th style=&quot;width:56%&quot;&gt;Chức năng chính&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;App Zone — k8s-scex-app-prod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Web App&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Giao diện trading web cho Customer (React SPA)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Backend API&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;BE API, Xác thực người dùng, điều phối nghiệp vụ trading/KYC/FIAT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Admin Portal&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Portal vận hành trung tâm cho Admin/Manager (Go SSR)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Admin SSO&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Cung cấp và quản lý SSO cho các admin portal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FIAT Portal&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Xử lý Nạp/Rút FIAT, tích hợp Bank Gateway&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;KYC Portal&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Quản lý dữ liệu và hồ sơ eKYC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Verify Portal&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Xác minh hồ sơ, đối chiếu thông tin C06&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Reporting Portal&lt;/td&gt;&lt;td&gt;App Zone&lt;/td&gt;&lt;td&gt;Báo cáo cho Manager&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;API Gateway&lt;/td&gt;&lt;td&gt;APISIX/Nginx&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Routing, rate limit&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Trading Zone&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Trading Engine&lt;/td&gt;&lt;td&gt;Trading Zone&lt;/td&gt;&lt;td&gt;Khớp lệnh, phát sinh order/match events&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bank Gateway&lt;/td&gt;&lt;td&gt;App (ns: bankgw)&lt;/td&gt;&lt;td&gt;Nạp/Rút FIAT qua ngân hàng (inhouse)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Wallet — k8s-scex-wallet-prod&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Coin Portal&lt;/td&gt;&lt;td&gt;Hot Wallet&lt;/td&gt;&lt;td&gt;Giao dịch coin, quản lý address/balance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Key Portal&lt;/td&gt;&lt;td&gt;Hot Wallet&lt;/td&gt;&lt;td&gt;Quản lý private key ví nóng (qua HSM)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cold Wallet Portal&lt;/td&gt;&lt;td&gt;Cold Wallet&lt;/td&gt;&lt;td&gt;Vận hành ví lạnh, ký qua Device Signer&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color: rgb(236, 239, 241); font-weight: bold;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;Data / Cache / Messaging&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PostgreSQL&lt;/td&gt;&lt;td&gt;Managed/VM&lt;/td&gt;&lt;td&gt;RDBMS chính — per-service database&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Redis&lt;/td&gt;&lt;td&gt;Managed/VM&lt;/td&gt;&lt;td&gt;Cache, session, pub/sub&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Memcached&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Object cache cho portal Ruby&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Kafka&lt;/td&gt;&lt;td&gt;Managed/VM&lt;/td&gt;&lt;td&gt;Event streaming (order/match events)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;NATS&lt;/td&gt;&lt;td&g